APP_NAME=AIOps Guardian
DEBUG=true
# Local default is SQLite. For Docker Compose Postgres:
# DATABASE_URL=postgresql+psycopg2://aiops:aiops@localhost:5432/aiops_guardian
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# auto | ollama | mock
LLM_PROVIDER=auto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./knowledge_base/chroma_db
KNOWLEDGE_RUNBOOKS_DIR=./knowledge_base/runbooks
KNOWLEDGE_UPLOADS_DIR=./knowledge_base/uploads

# Optional — private repos / higher GitHub API rate limits
GITHUB_TOKEN=
ANOMALY_WINDOW_SIZE=30
CORRELATION_WINDOW_SECONDS=120
